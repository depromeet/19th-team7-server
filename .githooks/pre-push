#!/bin/sh
# 브랜치 컨벤션 검사 (규칙: .claude/branch.md)
#   - main, develop에 직접 push 금지 (PR로만 머지)
#   - 브랜치 이름: {작업단위}/{이슈번호}-{description} 또는 hotfix/{이슈번호}-{description}
#     description은 소문자 kebab-case

TYPES='feat|fix|refactor|chore|docs|test|style|hotfix'
status=0

fail() {
  echo "" >&2
  echo "[pre-push] 브랜치 컨벤션 위반: $1" >&2
  echo "  형식: {작업단위}/{이슈번호}-{description}  (예: feat/12-kakao-login)" >&2
  echo "  규칙 문서: .claude/branch.md" >&2
  echo "" >&2
  status=1
}

# stdin: <local ref> <local sha> <remote ref> <remote sha>
while read -r local_ref local_sha remote_ref remote_sha; do
  # 브랜치가 아닌 ref(태그 등)는 검사하지 않는다
  case "$remote_ref" in
    refs/heads/*) ;;
    *) continue ;;
  esac
  branch=${remote_ref#refs/heads/}

  # 원격 브랜치 삭제(push --delete)는 허용한다
  case "$local_sha" in
    *[!0]*) ;;
    *) continue ;;
  esac

  case "$branch" in
    main|develop)
      fail "$branch 브랜치에는 직접 push할 수 없습니다. 작업 브랜치에서 PR을 올려 주세요"
      continue
      ;;
  esac

  if ! printf '%s\n' "$branch" | grep -Eq "^($TYPES)/[0-9]+-[a-z0-9]+(-[a-z0-9]+)*$"; then
    fail "브랜치 이름이 형식에 맞지 않습니다 -> \"$branch\""
  fi
done

exit $status
